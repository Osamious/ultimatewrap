# Logs and tool output — regenerated, never reviewed, sometimes large.
*.log
logs/
out.log
err.log
render.out
render.err
diag*.txt
*.tsv

# Backups written by keysync's safety machinery.
*.bak
*.bak-*
*.bak*
settings.json.bak-*

# Anything that has ever held credential material or credential ids.
keys.log
probe-account-endpoints.json
last-test-results.json

# Spike scratch: hand-made buffers from the ctrl+g handoff experiments.
spike/buf*.md
spike/d.md
spike/crlf.md
spike/probe.md
spike/t*.txt
spike/cc_strings.txt
spike/Usersosami*

# Isolated-test scratch tree — recreated by harness/bootstrap.mjs.
harness/scratch/

# Runtime state: per-machine, not source.
state/
catalog/
research/phase6/_tmp/

# The supervisor's own runtime state. Written by the scheduled task that keeps
# the CCR gateway and OAuth relay alive, so it churns on its own schedule and
# would otherwise be swept into every task commit by `git add -A`. Discovered at
# Task A4 execution; the supervise/*.ps1 scripts themselves stay tracked.
supervise/supervise-state.json

# Rust build output from the rescued prior-art crate. The crate is kept for its
# working model_tier.rs; its compiled artifacts are 3,225 files of regenerable
# object code, .pdb and .rlib. Discovered at Task A1 execution: `git add -A`
# staged them because no rule here covered them.
prior-art/uw-rust-tui/target/

# OMC's own runtime state (project memory, mode state, wiki). Per-machine and
# churns on its own schedule. It ships an inner .gitignore, but that does not
# stop the parent tree from offering the directory to `git add -A`.
.omc/

# Full clone of deepseek-ai/deepseek-harness, read at source for report 19's
# counterfactual. 102 MB / 9,080 files of someone else's repository; the report
# cites it by file:line and the clone is one `git clone` away if needed again.
spike/dsh-src/

# Raw research dumps behind reports 16 and 18: models.dev and litellm catalogue
# snapshots plus scraped env-var/error references, 8 MB total. Re-fetchable, and
# the conclusions drawn from them live in research/phase6/.
spike/research/

# Console-input experiment scripts for report 17 §4.2 (AttachConsole +
# WriteConsoleInput). That path was investigated and deliberately NOT adopted —
# it would cross UW's own never-auto-submit boundary. The design is recorded in
# the report; the scripts stay local so the repo does not ship keystroke-delivery
# tooling for an approach nobody chose.
spike/acw/

# Stdout/stderr capture from statusline shim runs.
spike/shim.out
spike/shim.err
