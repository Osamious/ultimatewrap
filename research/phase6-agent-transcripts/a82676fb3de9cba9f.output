ovider': 'orcarouter', 'bucket': 'personal', 'tier': 'free', 'envVarName': 'LLM_PERSONAL_ORCAROUTER_FREE', 'added': '2026-08-19T18:44:33'}\r\n{'id': 'personal.tokenharbor.free', 'provider': 'tokenharbor', 'bucket': 'personal', 'tier': 'free', 'envVarName': 'LLM_PERSONAL_TOKENHARBOR_FREE', 'added': '2026-08-19T18:52:57'}\r\n{'id': 'personal.routllm.free', 'provider': 'routllm', 'bucket': 'personal', 'tier': 'free', 'envVarName': 'LLM_PERSONAL_ROUTLLM_FREE', 'added': '2026-08-19T18:58:32'}\r\n{'id': 'personal.tokenrouter.free', 'provider': 'tokenrouter', 'bucket': 'personal', 'tier': 'free', 'envVarName': 'LLM_PERSONAL_TOKENROUTER_FREE', 'added': '2026-08-19T19:07:03'}\r\n{'id': 'personal.nararouter.free', 'provider': 'nararouter', 'bucket': 'personal', 'tier': 'free', 'envVarName': 'LLM_PERSONAL_NARAROUTER_FREE', 'added': '2026-08-19T20:30:39'}\r\n{'id': 'personal.teamorouter.free', 'provider': 'teamorouter', 'bucket': 'personal', 'tier': 'free', 'envVarName': 'LLM_PERSONAL_TEAMOROUTER_FREE', 'added': '2026-08-19T20:43:30'}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"sourceToolAssistantUUID":"2b2741b0-5101-4f24-a670-e039134ec558","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\osami\\.uw\\keysync","sessionId":"76ac34d9-c9e8-43f4-8cfa-18bf9783c39c","version":"2.1.257","gitBranch":"HEAD","slug":"curious-crafting-coral"}
